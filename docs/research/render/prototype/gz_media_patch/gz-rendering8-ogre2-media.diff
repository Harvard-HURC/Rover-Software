+// ROVER PATCH: distance haze (aerial perspective) for Pbs and Terra
+@piece( custom_ps_posExecution_haze )
+@property( !hlms_shadowcaster && !hlms_prepass && !hlms_render_depth_only && (hlms_normal || hlms_qtangent || detail_maps_diffuse || detail_maps_normal) )
+	{
+		float hazeF = 0.85 * ( 1.0 - exp( -length( inPs.pos ) * 4.000e-05 ) );
+		outPs_colour0.xyz = lerp( outPs_colour0.xyz, float3( 0.5149, 0.6038, 0.7305 ), hazeF );
+	}
+@end
+@end
