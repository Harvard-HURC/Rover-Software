<?xml version="1.0"?>
<sdf version="1.11">
  <model name="eye_camera">
    <link name="link">
      <gravity>false</gravity>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.000166666667</ixx>
          <iyy>0.000166666667</iyy>
          <izz>0.000166666667</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <sensor name="camera" type="camera">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <topic>/eye_camera/image</topic>
        <camera>
          <horizontal_fov>1.5</horizontal_fov>
          <image>
            <width>960</width>
            <height>540</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>80000</far>
          </clip>
        </camera>
      </sensor>
    </link>
    <plugin filename="ChaseCamera" name="rover_sim::ChaseCamera">
      <target>rover</target>
      <mount>0.35 0 0.85</mount>
      <yaw>0</yaw>
      <pitch>0.12</pitch>
      <min_yaw>-2.8</min_yaw>
      <max_yaw>2.8</max_yaw>
      <min_pitch>-0.6</min_pitch>
      <max_pitch>1.2</max_pitch>
      <look_topic>/eye_camera/look</look_topic>
      <state_topic>/eye_camera/state</state_topic>
    </plugin>
  </model>
</sdf>
