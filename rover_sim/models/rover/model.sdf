    <plugin name="gz::sim::systems::JointPositionController" filename="gz-sim-joint-position-controller-system">
      <joint_name>camera_pan_joint</joint_name>
      <topic>/model/rover/joint/camera_pan_joint/0/cmd_pos</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>10</p_gain>
      <cmd_max>2</cmd_max>
      <cmd_min>-2</cmd_min>
      <initial_position>0</initial_position>
    </plugin>
    <plugin name="gz::sim::systems::JointPositionController" filename="gz-sim-joint-position-controller-system">
      <joint_name>camera_tilt_joint</joint_name>
      <topic>/model/rover/joint/camera_tilt_joint/0/cmd_pos</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>10</p_gain>
      <cmd_max>2</cmd_max>
      <cmd_min>-2</cmd_min>
      <initial_position>0.12</initial_position>
    </plugin>
    <plugin name="rover_sim::RockerDifferential" filename="RockerDifferential">
      <left_joint>rocker_left_joint</left_joint>
      <right_joint>rocker_right_joint</right_joint>
      <stiffness>5000</stiffness>
      <damping>100</damping>
    </plugin>
    <plugin name="rover_sim::RoverDrivetrain" filename="RoverDrivetrain">
      <topic>/model/rover/cmd_vel</topic>
      <cmd_timeout>0.5</cmd_timeout>
      <cmd_timeout_clock>wall</cmd_timeout_clock>
      <odom_topic>/model/rover/odometry</odom_topic>
      <tf_topic>/model/rover/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <state_topic>/model/rover/drivetrain</state_topic>
      <state_rate>50</state_rate>
      <track>0.8</track>
      <radius>0.15</radius>
      <track_multiplier>1</track_multiplier>
      <wheel>
        <name>fl</name>
        <joint>wheel_fl_joint</joint>
        <link>wheel_fl</link>
        <side>left</side>
      </wheel>
      <wheel>
        <name>rl</name>
        <joint>wheel_rl_joint</joint>
        <link>wheel_rl</link>
        <side>left</side>
      </wheel>
      <wheel>
        <name>fr</name>
        <joint>wheel_fr_joint</joint>
        <link>wheel_fr</link>
        <side>right</side>
      </wheel>
      <wheel>
        <name>rr</name>
        <joint>wheel_rr_joint</joint>
        <link>wheel_rr</link>
        <side>right</side>
      </wheel>
      <motor>
        <voltage>48</voltage>
        <resistance>0.46</resistance>
        <kt>0.0445</kt>
        <ke>0.0445</ke>
        <gear>50</gear>
        <efficiency>0.8</efficiency>
        <rotor_inertia>1.2e-05</rotor_inertia>
        <free_current>1</free_current>
        <output_friction>0.05</output_friction>
        <current_limit>20</current_limit>
      </motor>
      <driveline>
        <stiffness>1500</stiffness>
        <damping>2</damping>
        <backlash>0.026</backlash>
      </driveline>
      <controller>
        <kp>4</kp>
        <ki>160</ki>
        <speed_filter>0.005</speed_filter>
        <accel>8</accel>
        <max_speed>20</max_speed>
        <substeps>4</substeps>
      </controller>
      <contact>
        <v_stribeck>0.03</v_stribeck>
        <v_align>0.005</v_align>
        <perp_ratio>0</perp_ratio>
        <stick_perp_ratio>0.3</stick_perp_ratio>
        <mu_noise>0.2</mu_noise>
        <mu_noise_length>0.3</mu_noise_length>
        <rr_w0>0.05</rr_w0>
        <dig>true</dig>
        <dig_heal_length>0.3</dig_heal_length>
        <default_surface>regolith</default_surface>
        <object_surface>manmade</object_surface>
        <surface>
          <key>regolith</key>
          <mu_s>0.62</mu_s>
          <mu_k>0.52</mu_k>
          <crr>0.1</crr>
          <bulldoze>0</bulldoze>
          <slip>0.3</slip>
          <sinkage_m>0.005</sinkage_m>
          <dig_rate>0</dig_rate>
          <dig_max>1</dig_max>
          <dust>0.4</dust>
        </surface>
        <surface>
          <key>manmade</key>
          <mu_s>0.8</mu_s>
          <mu_k>0.7</mu_k>
          <crr>0.015</crr>
          <bulldoze>0</bulldoze>
          <slip>0.05</slip>
          <sinkage_m>0</sinkage_m>
          <dig_rate>0</dig_rate>
          <dig_max>1</dig_max>
          <dust>0</dust>
        </surface>
      </contact>
      <dig_sink>
        <gain>1</gain>
        <max>0.06</max>
        <tau>0.1</tau>
      </dig_sink>
      <tracks>
        <spacing>0.05</spacing>
        <chunk>128</chunk>
        <max_segments>8000</max_segments>
        <berm_base>0.3</berm_base>
        <berm_gain>1</berm_gain>
        <berm_max>0.06</berm_max>
        <berm_min>0.004</berm_min>
        <opacity_base>0.14</opacity_base>
        <opacity_dig>0.3</opacity_dig>
        <floor_offset>0.004</floor_offset>
        <pit_dig>0.05</pit_dig>
        <smear_slip>0.3</smear_slip>
        <frame_budget>256</frame_budget>
        <stress>0</stress>
        <report>0</report>
        <width>0.1</width>
      </tracks>
    </plugin>
    <plugin name="gz::sim::systems::JointStatePublisher" filename="gz-sim-joint-state-publisher-system">
      <topic>/model/rover/joint_states</topic>
    </plugin>
    <plugin name="gz::sim::systems::OdometryPublisher" filename="gz-sim-odometry-publisher-system">
      <odom_topic>/model/rover/ground_truth</odom_topic>
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </model>
</sdf>
