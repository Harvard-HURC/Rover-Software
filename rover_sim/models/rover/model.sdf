      </visual>
      <visual name="lens_visual">
        <pose>0.024 0.03 0 0 1.57079633 0</pose>
        <geometry>
          <cylinder>
            <length>0.012</length>
            <radius>0.014</radius>
          </cylinder>
        </geometry>
