<?xml version="1.0"?>
<sdf version="1.11">
  <model name="rover">
    <link name="base_link">
      <inertial>
        <pose>0 0 0.4 0 0 0</pose>
        <mass>30</mass>
        <inertia>
          <ixx>0.725</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.7</iyy>
          <iyz>0</iyz>
          <izz>2.225</izz>
        </inertia>
      </inertial>
      <collision name="chassis_collision">
        <pose>0 0 0.4 0 0 0</pose>
        <geometry>
          <box>
            <size>0.8 0.5 0.2</size>
          </box>
        </geometry>
      </collision>
      <visual name="chassis_visual">
        <pose>0 0 0.4 0 0 0</pose>
        <geometry>
          <box>
            <size>0.8 0.5 0.2</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.85 0.55 0.15 1</diffuse>
          <ambient>0.85 0.55 0.15 1</ambient>
        </material>
      </visual>
      <visual name="gnss_mast_visual">
        <pose>-0.25 0 0.675 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.35</length>
            <radius>0.015</radius>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.35 0.35 0.38 1</diffuse>
          <ambient>0.35 0.35 0.38 1</ambient>
        </material>
      </visual>
      <visual name="gnss_antenna_visual">
        <pose>-0.25 0 0.85 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.02</length>
            <radius>0.06</radius>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.9 0.9 0.9 1</diffuse>
          <ambient>0.9 0.9 0.9 1</ambient>
        </material>
      </visual>
      <visual name="camera_mast_visual">
        <pose>0.35 0 0.645 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.29</length>
            <radius>0.015</radius>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.35 0.35 0.38 1</diffuse>
          <ambient>0.35 0.35 0.38 1</ambient>
        </material>
      </visual>
      <visual name="led_visual">
        <pose>-0.41 0 0.47 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02 0.16 0.06</size>
          </box>
        </geometry>
        <material>
          <emissive>0 0 0 1</emissive>
          <diffuse>0.15 0.15 0.15 1</diffuse>
          <ambient>0.15 0.15 0.15 1</ambient>
        </material>
      </visual>
      <sensor name="gnss" type="navsat">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>/model/rover/navsat</topic>
        <navsat>
          <position_sensing>
            <horizontal>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>4.49155587e-06</stddev>
              </noise>
            </horizontal>
            <vertical>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>1</stddev>
              </noise>
            </vertical>
          </position_sensing>
        </navsat>
        <pose>-0.25 0 0.85 0 0 0</pose>
        <gz_frame_id>gnss</gz_frame_id>
      </sensor>
      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/model/rover/imu</topic>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.002</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.002</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.002</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.02</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.02</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.02</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
        <pose>0 0 0.4 0 0 0</pose>
        <gz_frame_id>base_link</gz_frame_id>
      </sensor>
    </link>
