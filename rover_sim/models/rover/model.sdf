    <joint name="camera_pan_joint" type="revolute">
      <parent>base_link</parent>
      <child>camera_pan_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-2.8</lower>
          <upper>2.8</upper>
          <effort>5</effort>
          <velocity>2</velocity>
        </limit>
        <dynamics>
          <damping>0.01</damping>
          <friction>0</friction>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <joint name="camera_tilt_joint" type="revolute">
      <parent>camera_pan_link</parent>
      <child>camera_tilt_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.6</lower>
          <upper>1.2</upper>
          <effort>5</effort>
          <velocity>2</velocity>
        </limit>
        <dynamics>
          <damping>0.01</damping>
          <friction>0</friction>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <joint name="rocker_left_joint" type="revolute">
      <parent>base_link</parent>
      <child>rocker_left</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.5</lower>
          <upper>0.5</upper>
          <effort>-1</effort>
          <velocity>-1</velocity>
        </limit>
        <dynamics>
          <damping>0.5</damping>
          <friction>0</friction>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <joint name="wheel_fl_joint" type="revolute">
      <parent>rocker_left</parent>
      <child>wheel_fl</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <effort>1000</effort>
          <velocity>32</velocity>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <joint name="wheel_rl_joint" type="revolute">
