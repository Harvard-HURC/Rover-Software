<?xml version="1.0"?>
<sdf version="1.11">
  <model name="fly_camera">
    <link name="link">
      <gravity>false</gravity>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.000166666667</ixx>
          <iyy>0.000166666667</iyy>
          <izz>0.000166666667</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <sensor name="camera" type="camera">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <topic>/fly_camera/image</topic>
        <camera>
          <horizontal_fov>1.2</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>80000</far>
          </clip>
        </camera>
      </sensor>
    </link>
    <plugin filename="FlyCamera" name="rover_sim::FlyCamera">
      <target>rover</target>
      <clearance>1</clearance>
      <time_constant>0.2</time_constant>
      <look_time_constant>0.08</look_time_constant>
      <deadman>0.3</deadman>
      <deadman_clock>wall</deadman_clock>
      <speed_per_agl>1</speed_per_agl>
      <min_speed>2</min_speed>
      <max_speed>200</max_speed>
      <fast>4</fast>
      <min_scale>0.25</min_scale>
      <max_scale>4</max_scale>
      <max_altitude>2000</max_altitude>
      <margin>100</margin>
      <cmd_topic>/fly_camera/cmd</cmd_topic>
      <speed_topic>/fly_camera/speed</speed_topic>
      <look_topic>/fly_camera/look</look_topic>
      <goto_topic>/fly_camera/goto</goto_topic>
      <mode_topic>/fly_camera/mode</mode_topic>
      <state_topic>/fly_camera/state</state_topic>
    </plugin>
  </model>
</sdf>
